{
  "manifest_version": 3,
  "name": "ChatRelay — Cross-AI Cockpit, Timeline & Reality Check",
  "version": "1.0.0",
  "homepage_url": "https://github.com/zhangxiangyi2022-maker/ai-chat-relay",
  "description": "Metro timeline & fork, multi-tab Dynamic Island radar & broadcast, Pinboard, anti-hallucination package/repo verifier, and privacy-first handoff for ChatGPT, Gemini, Claude, and DeepSeek.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://registry.npmjs.org/*",
    "https://pypi.org/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatRelay",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
